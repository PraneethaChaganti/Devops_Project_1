pipeline {
	agent any
	stages {
		stage('terraform init') {
			steps {
				sh 'terraform init'
				// Initialize Terraform and set up the backend configuration
			}
		}
		stage('terraform plan') {
			steps {
				sh 'terraform plan'
				// perform a Terraform plan to see the changes that will be applied
			}
		}
		stage('terraform apply') {
			steps {
				sh 'terraform apply'
				// perform a Terraform apply to create or update the infrastructure based on the plan
			}
		}
	}
}