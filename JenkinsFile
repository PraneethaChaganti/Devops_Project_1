pipeline {
	agent any
	stages {
		stage('terraform steps') {
			steps {
				sh 'rm -rf .terraform'
				sh 'rm -rf .terraform.lock.hcl'
				sh 'terraform init -upgrade'
				withEnv([
					"VAULT_ADDR=http://vault:8200",
					"VAULT_TOKEN=${VAULT_TOKEN_SECRET}"
				]) {
					sh '''
						terraform plan
						terraform apply -auto-approve
					'''
				}
			}
		}
	}
}
