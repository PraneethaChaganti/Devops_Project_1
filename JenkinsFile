pipeline {
	agent any
	stages {
		stage('terraform steps') {
			steps {
				withEnv([
					"VAULT_ADDR=http://vault:8200",
					"VAULT_TOKEN=${VAULT_TOKEN_SECRET}"
				]) {

				sh '''
					rm -rf .terraform
					rm -rf .terraform.lock.hcl
					terraform init -upgrade
					terraform plan
					terraform apply -auto-approve
				'''
				}
			}
		}
	}
}
