pipeline {
	agent any
	stages {
		stage('terraform steps') {
			steps {
				sh 'rm -rf .terraform'
				sh 'rm -rf .terraform.lock.hcl'
				sh 'rm -rf ~/.terraform.d/plugin-cache'
				sh 'terraform init -upgrade'
				sh 'terraform plan'
				sh 'terraform apply -auto-approve'
				//doing this in a single stage for simplicity, but can be broken down into multiple stages if needed
			}
		}
	}
}
