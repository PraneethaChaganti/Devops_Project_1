pipeline {
	agent any
	stages {
		stage('terraform steps') {
			steps {
				
                withCredentials([
                    string(credentialsId: 'vault-token', variable: 'VAULT_TOKEN')
                ]) {

                    withEnv([
                        "VAULT_ADDR=http://vault:8200"
                    ]) {

                        sh '''
                            rm -rf .terraform
                            rm -rf .terraform.lock.hcl

                            terraform init -upgrade
                            terraform plan
                            terraform apply -auto-approve
                        '''
                    }
                }
			}
		}
	}
}
